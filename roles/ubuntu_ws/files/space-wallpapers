#!/usr/bin/python3
"""Rotating NASA space wallpapers for a GNOME desktop.

Picks images from the NASA Image and Video Library (public domain, no API key),
downloads them to --dir, writes a GNOME slideshow playlist and points
org.gnome.desktop.background at it. With enough images already on disk and no
--refresh it never touches the network, so re-runs are fast and idempotent.
Installed to ~/.local/bin and refreshed weekly by space-wallpapers.timer
(Ansible role ubuntu_ws).
"""
import argparse
import json
import glob
import hashlib
import os
import random
import subprocess
import sys
import urllib.parse
import urllib.request
from xml.sax.saxutils import escape

API = "https://images-api.nasa.gov/search"
UA = {"User-Agent": "space-wallpapers/1.0"}
MAX_BYTES = 25 * 1024 * 1024
MIN_BYTES = 50 * 1024      # smaller files are treated as missing/broken
MIN_IMAGES = 3
# GNOME caches a parsed slideshow by file name for the whole session and keeps
# serving the old image list after the XML changes (verified: it kept asking for
# a pruned file). A content-hashed file name makes every new playlist a new URI.
PLAYLIST_DIR = os.path.expanduser("~/.local/share/backgrounds")
PLAYLIST_GLOB = "space-wallpapers-*.xml"
QUERIES = ["nebula hubble", "spiral galaxy", "webb telescope nebula", "hubble deep field",
           "saturn rings cassini", "aurora seen from the space station", "jupiter juno",
           "mars panorama", "milky way night sky", "supernova remnant", "star cluster", "earth at night"]
# The library is full of press/event/hardware photos tagged with mission names
# (the first run gave us a "thanks for all your hard work" cake). Skip anything
# whose title, description or keywords smell like people, events or clean rooms.
SKIP_WORDS = ["cake", "ceremony", "team", "employee", "press", "conference", "briefing", "award",
              "visit", "meeting", "administrator", "ribbon", "signing", "interview", "tour", "panel",
              "students", "portrait", "crowd", "audience", "speaks", "poses", "clean room", "cleanroom",
              "assembly", "integration", "testing", "mirror segment", "lift", "crane", "facility",
              "building", "headquarters", "booth", "exhibit", "model", "illustration", "artist",
              "concept", "logo", "patch", "poster", "infographic", "chart", "diagram", "map of"]


def parse_args():
    p = argparse.ArgumentParser(description=__doc__.split("\n", 1)[0])
    p.add_argument("--dir", default="~/Pictures/space-wallpapers", help="image directory (default %(default)s)")
    p.add_argument("--count", type=int, default=12, help="images in the slideshow (default %(default)s)")
    p.add_argument("--queries", nargs="+", default=QUERIES, metavar="QUERY",
                   help="NASA library search terms, used round-robin")
    p.add_argument("--duration", type=int, default=900, metavar="SECONDS",
                   help="seconds each image is shown (default %(default)s)")
    p.add_argument("--transition", type=int, default=5, metavar="SECONDS",
                   help="cross-fade seconds (default %(default)s)")
    p.add_argument("--no-set", action="store_true", help="write the playlist but leave gsettings alone")
    p.add_argument("--refresh", action="store_true",
                   help="ignore the manifest and pick new images (downloaded files are kept)")
    return p.parse_args()


def warn(msg):
    print(f"space-wallpapers: warning: {msg}", file=sys.stderr)


def get_json(url):
    with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=30) as r:
        return json.load(r)


def https(url):
    # The asset manifests list http:// URLs; the same hosts serve https.
    return "https://" + url[len("http://"):] if url.startswith("http://") else url


def search(query):
    # 100 results shuffled rather than the top 10, so --refresh actually brings new images.
    q = urllib.parse.urlencode({"q": query, "media_type": "image", "page_size": 100})
    items = get_json(f"{API}?{q}").get("collection", {}).get("items", [])
    random.shuffle(items)
    return items


def looks_like_event(data):
    text = " ".join([data.get("title", ""), data.get("description", ""),
                     " ".join(data.get("keywords") or [])]).lower()
    return any(w in text for w in SKIP_WORDS)


def valid(path):
    return os.path.isfile(path) and os.path.getsize(path) > MIN_BYTES


def download(item, path):
    """Fetch the ~large (else ~orig) JPEG of a search item to path; returns its URL."""
    assets = get_json(https(item["href"]))
    url = next((a for suffix in ("~large.jpg", "~orig.jpg") for a in assets if a.endswith(suffix)), None)
    if url is None:
        raise ValueError("no ~large.jpg/~orig.jpg variant")
    url = https(url)
    with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=60) as r:
        size = int(r.headers.get("Content-Length") or 0)
        if not r.headers.get_content_type().startswith("image/"):
            raise ValueError(f"not an image ({r.headers.get_content_type()})")
        if size > MAX_BYTES:
            raise ValueError(f"too large ({size // (1024 * 1024)} MB)")
        tmp = path + ".part"
        try:
            with open(tmp, "wb") as f:
                while chunk := r.read(1 << 16):
                    f.write(chunk)
                    if f.tell() > MAX_BYTES:
                        raise ValueError("too large")
        except BaseException:
            os.remove(tmp)
            raise
    os.replace(tmp, path)
    try:
        check_dimensions(path)
    except ValueError:
        os.remove(path)
        raise
    return url


def check_dimensions(path):
    """Landscape and at least 1600 px wide: the library's ~large variant can be tiny."""
    try:
        from PIL import Image
    except ImportError:
        return
    with Image.open(path) as im:
        w, h = im.size
    # Portrait and extreme panoramas lose most of the picture to the zoom crop on 16:9.
    if w < 1600 or w < h or w > 2.2 * h:
        raise ValueError(f"unsuitable size {w}x{h}")


def collect(args, outdir, manifest_path):
    """Return (entries, downloaded): at least what is wanted, from disk and the API."""
    entries = []
    if not args.refresh and os.path.isfile(manifest_path):
        with open(manifest_path) as f:
            entries = [e for e in json.load(f) if valid(os.path.join(outdir, e["nasa_id"] + ".jpg"))]
    if len(entries) >= args.count:
        return entries[:args.count], 0

    seen = {e["nasa_id"] for e in entries}
    results = {}
    downloaded = 0
    # Round-robin over the queries, one new item per query per pass, until enough.
    while len(entries) < args.count:
        progress = False
        for query in args.queries:
            if len(entries) >= args.count:
                break
            if query not in results:
                try:
                    results[query] = search(query)
                except Exception as e:
                    warn(f"search {query!r} failed: {e}")
                    results[query] = []
            while results[query]:
                item = results[query].pop()
                data = (item.get("data") or [{}])[0]
                nasa_id = data.get("nasa_id")
                if not nasa_id or nasa_id in seen or "href" not in item:
                    continue
                if looks_like_event(data):
                    seen.add(nasa_id)
                    continue
                seen.add(nasa_id)
                path = os.path.join(outdir, nasa_id + ".jpg")
                try:
                    if valid(path):
                        url = https(item["href"])
                    else:
                        url = download(item, path)
                        downloaded += 1
                except Exception as e:
                    warn(f"{nasa_id}: {e}")
                    continue
                entries.append({"nasa_id": nasa_id, "title": data.get("title", ""), "url": url})
                progress = True
                break
        if not progress:
            break
    return entries, downloaded


def playlist_xml(paths, duration, transition):
    out = ["<background>",
           "  <starttime><year>2020</year><month>01</month><day>01</day>"
           "<hour>00</hour><minute>00</minute><second>00</second></starttime>"]
    for cur, nxt in zip(paths, paths[1:] + paths[:1]):
        out += [f"  <static><duration>{duration}</duration><file>{escape(cur)}</file></static>",
                f'  <transition type="overlay"><duration>{transition}</duration>'
                f"<from>{escape(cur)}</from><to>{escape(nxt)}</to></transition>"]
    out.append("</background>")
    return "\n".join(out) + "\n"


def set_background(uri):
    """Point GNOME at the playlist; returns True if anything changed."""
    # A systemd user unit does not always carry the session bus address.
    if "DBUS_SESSION_BUS_ADDRESS" not in os.environ:
        runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
        os.environ["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={runtime}/bus"
    changed = False
    for key, value in (("picture-uri", uri), ("picture-uri-dark", uri), ("picture-options", "zoom")):
        cur = subprocess.run(["gsettings", "get", "org.gnome.desktop.background", key],
                             capture_output=True, text=True, check=True).stdout.strip()
        if cur != f"'{value}'":
            subprocess.run(["gsettings", "set", "org.gnome.desktop.background", key, value], check=True)
            changed = True
    return changed


def main():
    args = parse_args()
    outdir = os.path.expanduser(args.dir)
    os.makedirs(outdir, exist_ok=True)
    manifest_path = os.path.join(outdir, "manifest.json")

    entries, downloaded = collect(args, outdir, manifest_path)
    if len(entries) < MIN_IMAGES:
        print(f"space-wallpapers: only {len(entries)} images available, need at least {MIN_IMAGES}",
              file=sys.stderr)
        return 1
    manifest = json.dumps(entries, indent=2) + "\n"
    if not os.path.isfile(manifest_path) or open(manifest_path).read() != manifest:
        with open(manifest_path, "w") as f:
            f.write(manifest)

    # Shuffle seeded by the image set: a new set gets a new order, a re-run with
    # the same set rewrites nothing.
    paths = sorted(os.path.join(outdir, e["nasa_id"] + ".jpg") for e in entries)
    random.Random(",".join(paths)).shuffle(paths)
    xml = playlist_xml(paths, args.duration, args.transition)
    os.makedirs(PLAYLIST_DIR, exist_ok=True)
    digest = hashlib.sha1(xml.encode()).hexdigest()[:10]
    playlist = os.path.join(PLAYLIST_DIR, f"space-wallpapers-{digest}.xml")
    if not os.path.isfile(playlist):
        with open(playlist, "w") as f:
            f.write(xml)
    for old in glob.glob(os.path.join(PLAYLIST_DIR, PLAYLIST_GLOB)):
        if old != playlist:
            os.remove(old)

    # Prune images that dropped out of the playlist so a weekly --refresh does not
    # grow the folder forever (anything in the manifest is kept).
    keep = set(paths)
    for name in os.listdir(outdir):
        full = os.path.join(outdir, name)
        if name.endswith(".jpg") and full not in keep:
            os.remove(full)

    state = "unchanged"
    if not args.no_set and set_background("file://" + playlist):
        state = "set"
    print(f"wallpapers: {len(entries)} images ({downloaded} downloaded), playlist {playlist}, background {state}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
